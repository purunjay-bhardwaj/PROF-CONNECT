[Unit]
Description=ProfConnect Flask server
After=network.target

[Service]
User=pi
WorkingDirectory=/home/pi/profconnect
EnvironmentFile=/home/pi/profconnect/.env
ExecStart=/home/pi/profconnect/.venv/bin/gunicorn --workers 2 --bind 0.0.0.0:5000 app:app
Restart=always

[Install]
WantedBy=multi-user.target
