# For VPS HTTPS deployment: point this hostname at your server first.
DOMAIN=meet.example.com
# Empty means enforce same-origin. Set explicitly for a separate frontend.
ALLOWED_ORIGINS=
DATABASE_PATH=/app/data/gather.db
MAX_PARTICIPANTS=4
ROOM_TTL_HOURS=24
PREVIEW_MODE=false

# TURN is strongly recommended for calls across different networks.
# Use a managed service OR your own coturn. Never place TURN_SECRET in frontend code.
TURN_URLS=
TURN_SECRET=
# For managed providers using fixed credentials, leave TURN_SECRET empty:
TURN_USERNAME=
TURN_PASSWORD=
# Only for the optional Linux VPS coturn service.
TURN_EXTERNAL_IP=
